# DataMap-Lite Environment Configuration
# Copy this file to .env and modify the values

# ============================================
# Database Configuration
# ============================================
DB_USER=datamap
DB_PASSWORD=your-secure-password-here
DB_NAME=datamap
DB_PORT=5432

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: Change this in production!
# Must be exactly 32 bytes for AES-256-GCM encryption
ENCRYPTION_KEY=change-me-in-production-32bytes!

# ============================================
# Server Configuration
# ============================================
API_PORT=8080
WEB_PORT=80

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Optional: pgAdmin Configuration
# ============================================
PGADMIN_EMAIL=admin@datamap.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ============================================
# Docker Image Registry (for CI/CD)
# ============================================
# DOCKER_REGISTRY=your-registry.com
# DOCKER_USERNAME=your-username
# DOCKER_PASSWORD=your-password
