# DataMap-Lite Environment Configuration
# Copy this file to .env and modify the values

# ============================================
# Database Configuration
# ============================================
DB_USER=datamap
DB_PASSWORD=your-secure-password-here
DB_NAME=datamap
DB_PORT=5432

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: Change this in production!
# Must be exactly 32 bytes for AES-256-GCM encryption
ENCRYPTION_KEY=change-me-in-production-32bytes!
JWT_SECRET=change-me-in-production-jwt-secret

# ============================================
# Optional: Cornerstone Governance Integration
# ============================================
DATAMAP_GOVERNANCE_ENABLED=false
DATAMAP_GOVERNANCE_ENDPOINT=http://localhost:8081/api/integrations/events
DATAMAP_GOVERNANCE_INTEGRATION_TOKEN=change-me-integration-token
DATAMAP_GOVERNANCE_SOURCE_SYSTEM=fuckcmdb
DATAMAP_GOVERNANCE_TIMEOUT=5s

# ============================================
# Server Configuration
# ============================================
API_PORT=8080

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# Optional: pgAdmin Configuration
# ============================================
PGADMIN_EMAIL=admin@datamap.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# ============================================
# Docker Image Registry (for CI/CD)
# ============================================
# 建议使用中国区 OCI 仓库，例如阿里云 ACR / 腾讯云 TCR / 华为云 SWR
# OCI_REGISTRY=registry.cn-hangzhou.aliyuncs.com
# OCI_NAMESPACE=your-namespace

# ============================================
# Mainland China Friendly Mirrors (Docker / Build)
# ============================================
DATAMAP_GOPROXY=https://goproxy.cn,direct
DATAMAP_GOSUMDB=sum.golang.google.cn
DATAMAP_NPM_REGISTRY=https://registry.npmmirror.com
DATAMAP_PNPM_VERSION=10.28.0
DATAMAP_NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
DATAMAP_GO_IMAGE=docker.m.daocloud.io/library/golang:1.25.4-alpine
DATAMAP_RUNTIME_IMAGE=docker.m.daocloud.io/library/alpine:3.20
DATAMAP_POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
DATAMAP_PGADMIN_IMAGE=docker.m.daocloud.io/dpage/pgadmin4:latest
# DATAMAP_BACKEND_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/datamap:latest
